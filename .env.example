# Copy to .env and edit. Every value below is optional; scripts fall back to
# the defaults in scripts/lib.sh and configs/production.json.

# Host port published by the container (container port is always 8000).
# PORT=8013

# Bind address for the published port. 127.0.0.1 keeps the API on this host.
# BIND_ADDR=127.0.0.1

# Container and image names. The nightly tag is pinned by digest in
# configs/production.json; override IMAGE to test a different build.
# CONTAINER=vllm-flint-nvfp4
# IMAGE=vllm/vllm-openai:nightly

# Served model alias.
# SERVED_NAME=flint

# Longest sequence the engine will admit. The recipe context is 262,144.
# MAX_MODEL_LEN=262144

# Concurrent sequences and prefill chunk. Flint uses a low-latency decode
# path for up to 8 concurrent requests.
# MAX_NUM_SEQS=16
# MAX_NUM_BATCHED_TOKENS=8192

# Fraction of unified memory vLLM may plan with.
# GPU_MEMORY_UTILIZATION=0.85

# GLM-4.7 parsers, per the recipe.
# REASONING_PARSER=glm47
# TOOL_CALL_PARSER=glm47

# unless-stopped keeps serving across reboots; "no" disables restarts.
# RESTART_POLICY=unless-stopped

# Seconds to wait for /health after start. The GGUF is repacked at load.
# START_TIMEOUT=2400
